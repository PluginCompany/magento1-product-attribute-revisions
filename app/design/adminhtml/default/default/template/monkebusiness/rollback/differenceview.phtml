    <script>
        var value, orig1, dv, panes = 2, highlight = true, connect = null, collapse = false;
        <?php if($this->enableMerge()){ ?>
            var textAttributes = <?php echo $this->getTextJSON(); ?>;
            var textAttrCount = textAttributes.length;
            var textCurrent = 0;
            value = textAttributes[0].current_value;
            orig1 = textAttributes[0].old_value;
            setAttrName(textAttributes[0].label);
        <?php }else{ ?>
                value = <?php echo json_encode($this->getValueOne()); ?>;
                orig1 = <?php echo json_encode($this->getValueTwo()); ?>;
        <?php } ?>
        function initUI() {
            if (value == null) return;
            var target = document.getElementById("view");
            target.innerHTML = "";
            dv = CodeMirror.MergeView(target, {
                value: value,
                orig: orig1,
                lineNumbers: true,
                mode: "text/html",
                highlightDifferences: highlight,
                connect: connect
            });
            parent.codem = dv;
        }

        function toggleDifferences() {
            dv.setShowDifferences(highlight = !highlight);
        }

        window.onload = function() {
            initUI();
        }

        function mergeViewHeight(mergeView) {
            function editorHeight(editor) {
                if (!editor) return 0;
                return editor.getScrollInfo().height;
            }
            return Math.max(editorHeight(mergeView.leftOriginal()),
                editorHeight(mergeView.editor()),
                editorHeight(mergeView.rightOriginal()));
        }

        function resize(mergeView) {
            var height = mergeViewHeight(mergeView);
            for(;;) {
                if (mergeView.leftOriginal())
                    mergeView.leftOriginal().setSize(null, height);
                mergeView.editor().setSize(null, height);
                if (mergeView.rightOriginal())
                    mergeView.rightOriginal().setSize(null, height);

                var newHeight = mergeViewHeight(mergeView);
                if (newHeight >= height) break;
                else height = newHeight;
            }
            mergeView.wrap.style.height = height + "px";
        }

        function applyOldValue() {
            textAttributes[textCurrent].value_to_save = orig1;
            nextAttr();
        }

        function applyMergedValue(){
            textAttributes[textCurrent].value_to_save = dv.editor().getValue();
            nextAttr();
        }

        function nextAttr() {
            textCurrent++;
            if(textCurrent >= textAttrCount){
                return submitForm();
            }
            dv.editor().setValue(textAttributes[textCurrent].current_value);
            dv.rightOriginal().setValue(textAttributes[textCurrent].old_value);
            setAttrName(textAttributes[textCurrent].label);
        }

        function submitForm() {
            <?php
            $jsn = $this->getNumericJSON();
            if(!$jsn){
                $jsn = 'null';
            }
            ?>
            var numeric = <?php echo $jsn; ?>;
            var form = jQuery('<form action="<?php echo $this->getFormUrl(); ?>" method="POST">' +
                '<input type="hidden" id="text" name="text" value="">' +
                '<input type="hidden" id="numeric_json" name="numeric_json" value="">' +
                '<?php echo str_replace(array("\n","\r",PHP_EOL),'',$this->getBlockHtml('formkey')); ?>' +
                '</form>');

            form.find('#text').val(JSON.stringify(textAttributes));
            form.find('#numeric_json').val(JSON.stringify(<?php echo $jsn; ?>));
            form.hide().appendTo('body');
            form.submit();
        }

        function setAttrName(value) {
            jQuery('#attrname').text(value);
        }

    </script>
