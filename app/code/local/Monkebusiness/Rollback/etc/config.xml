<?xml version="1.0"?>
<config>
    <modules>
        <Monkebusiness_Rollback>
            <version>1.1.4</version>
        </Monkebusiness_Rollback>
    </modules>
    <global>
        <models>
            <monkebusiness_rollback>
                <class>Monkebusiness_Rollback_Model</class>
                <resourceModel>monkebusiness_rollback_resource</resourceModel>
            </monkebusiness_rollback>
            <monkebusiness_rollback_resource>
                <class>Monkebusiness_Rollback_Model_Resource</class>
                <entities>
                    <change>
                        <table>monkebusiness_change</table>
                    </change>
                    <change_product>
                        <table>monkebusiness_change_product</table>
                    </change_product>
                </entities>
            </monkebusiness_rollback_resource>
        </models>
        <blocks>
            <monkebusiness_rollback>
                <class>Monkebusiness_Rollback_Block</class>
            </monkebusiness_rollback>
        </blocks>
        <helpers>
            <monkebusiness_rollback>
                <class>Monkebusiness_Rollback_Helper</class>
            </monkebusiness_rollback>
        </helpers>
        <resources>
            <monkebusiness_rollback_setup>
                <setup>
                    <module>Monkebusiness_Rollback</module>
                </setup>
            </monkebusiness_rollback_setup>
        </resources>
    </global>
    <adminhtml>
        <events>
            <catalog_product_save_after>
                <observers>
                    <monkebusiness_rollback>
                        <type>model</type>
                        <class>monkebusiness_rollback/observer</class>
                        <method>catalogProductSaveAfter</method>
                    </monkebusiness_rollback>
                </observers>
            </catalog_product_save_after>
            <cataloginventory_stock_item_save_after>
                <observers>
                    <monkebusiness_rollback>
                        <type>model</type>
                        <class>monkebusiness_rollback/observer</class>
                        <method>cataloginventoryStockItemSaveAfter</method>
                    </monkebusiness_rollback>
                </observers>
            </cataloginventory_stock_item_save_after>
            <core_block_abstract_to_html_before>
                <observers>
                    <monkebusiness_rollback>
                        <type>model</type>
                        <class>monkebusiness_rollback/observer</class>
                        <method>coreBlockAbstractToHtmlBefore</method>
                    </monkebusiness_rollback>
                </observers>
            </core_block_abstract_to_html_before>
            <controller_action_layout_render_before_adminhtml_catalog_product_edit>
                <observers>
                    <add_rollback_js>
                        <type>model</type>
                        <class>monkebusiness_rollback/observer</class>
                        <method>addRollbackJs</method>
                    </add_rollback_js>
                </observers>
            </controller_action_layout_render_before_adminhtml_catalog_product_edit>

        </events>
        <layout>
            <updates>
                <monkebusiness_rollback>
                    <file>monkebusiness_rollback.xml</file>
                </monkebusiness_rollback>
            </updates>
        </layout>
    </adminhtml>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <rollback before="Mage_Adminhtml">Monkebusiness_Rollback_Adminhtml</rollback>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
</config>